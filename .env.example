# Copy to .env and fill in. Never commit .env.

# Postgres. The docker-compose default matches this value.
DATABASE_URL="postgresql://podium:podium@localhost:5432/podium"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# GitHub OAuth app.
# Callback: http://localhost:3000/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# Email. Judge magic links depend on this — see docs/SELF_HOSTING.md.
RESEND_API_KEY=""
EMAIL_FROM="Podium <hackathon@example.dev>"
